# Which AI provider Jarvis uses: anthropic, nvidia, ollama or custom
JARVIS_PROVIDER=anthropic

# anthropic: Claude. Key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# nvidia: models hosted by NVIDIA. Key from https://build.nvidia.com
# NVIDIA_API_KEY=

# ollama: models running on your own computer, no key or bill.
# Install from https://ollama.com, download a model, then set JARVIS_MODEL to its
# name exactly as `ollama list` shows it.

# custom: any other OpenAI-compatible API (OpenRouter, Groq, Together, LM Studio...)
# JARVIS_BASE_URL=https://openrouter.ai/api/v1
# JARVIS_API_KEY=
# JARVIS_MODEL=

# Model overrides. Each provider has its own defaults:
#   anthropic  claude-opus-5-5
#   nvidia     meta/llama-4-maverick-17b-128e-instruct (swapped automatically if retired)
#   ollama     llama3.2                     (vision: llama3.2-vision)
# JARVIS_MODEL=
# JARVIS_VISION_MODEL=             # Ask mode's model, if JARVIS_MODEL can't read images

# Email (optional): your address and an app password, not your normal password.
# See the README for how to make an app password.
# EMAIL_ADDRESS=
# EMAIL_APP_PASSWORD=
# EMAIL_IMAP_HOST=                 # only if Jarvis doesn't know your provider

# Dictionary and calendar
# JARVIS_VOCABULARY=Kai, Kosha     # names Jarvis should hear and spell right (also in the app)
# JARVIS_CALENDAR=                 # calendar for new events; default is the first you can edit

# TVs, speakers and smart home
# JARVIS_DEVICES=1                 # 0 stops Jarvis looking for TVs and speakers
# HOME_ASSISTANT_URL=http://homeassistant.local:8123
# HOME_ASSISTANT_TOKEN=            # long-lived token from your Home Assistant profile page

# Jarvis texting and calling you
# JARVIS_MY_NUMBER=               # your number, so Jarvis can text and call you
# JARVIS_IMESSAGE=1              # text yourself "Jarvis, ..." to give commands (Mac)
# JARVIS_IMESSAGE_TRIGGER=jarvis  # the word those messages start with
# TWILIO_SID=                     # optional: a real separate number for Jarvis
# TWILIO_TOKEN=
# TWILIO_FROM=
# NTFY_TOPIC=                     # optional: free phone alerts via the ntfy app instead
# NTFY_REPLY_TOPIC=               # optional: a second secret topic for messages from your phone
# JARVIS_PHONE_REPLIES=imessage   # answer those messages by iMessage instead of ntfy
# Jarvis on more than one Mac. Set these with `python -m jarvis.macs <name>`.
# JARVIS_MAC_NAME=main             # this Mac's name, like main or old
# NTFY_MACS_TOPIC=                 # a secret topic all your Macs share

# Memory, weather, timers and briefings
# JARVIS_LOCATION=Princeton, NJ   # for the weather (Jarvis can also remember it)
# JARVIS_UNITS=auto               # auto, fahrenheit or celsius
# JARVIS_BRIEFING_TIME=07:30      # a spoken briefing at this time each day
# JARVIS_ALERTS_TO_PHONE=1        # also send timers and reminders to your phone (ntfy)
# JARVIS_HABIT_SUGGESTIONS=1      # offer things you usually ask for at about this time
# JARVIS_MIC=auto                 # auto prefers the Mac's own mic; default follows Settings
# JARVIS_WHISPER_MODEL=auto       # auto: large-v3-turbo on the GPU with mlx-whisper, else small.en
# JARVIS_LANGUAGE=en              # the language you speak; empty to detect it

# Screen control
# JARVIS_SCREEN_WIDTH=1280         # screenshot size the AI sees
# JARVIS_SCREEN_GRID=1             # coordinate grid on screenshots (default off for Claude)
# JARVIS_MAX_SCREEN_STEPS=25

# Other settings (defaults shown)
# JARVIS_SPEAK=1                   # 0 to stop Jarvis reading replies aloud
# JARVIS_VOICE_ENGINE=auto         # kokoro, system, or auto (Kokoro when installed)
# JARVIS_VOICE=bm_george           # a Kokoro voice, or a Mac voice like Daniel
# JARVIS_VOICE_SPEED=1.0
# JARVIS_NOTCH=1                   # 0 to turn off the notch panel on a Mac
# JARVIS_APP=1                     # 0 to start without the Jarvis app window
# JARVIS_THINKING=0                # 1 lets Ollama models think first: smarter, much slower
# JARVIS_CLEAN_DICTATION=1         # 0 pastes Whisper's text as-is: faster, but filler words stay
# JARVIS_SCREENSHOT_WIDTH=1024     # Ask mode screenshot size; smaller is faster (1568 for Claude)
# On a Mac: hold a key to talk. fn, right_cmd, right_option, right_ctrl or right_shift
# JARVIS_HOLD=right_option         # the one key for everything
# JARVIS_ONE_KEY=1                 # 0 gives each mode its own key (below)
# JARVIS_DICTATE_HOLD=fn
# JARVIS_ASK_HOLD=right_cmd
# JARVIS_COMMAND_HOLD=right_option
# JARVIS_HOLD_KEYS=1               # 0 uses the press-twice hotkeys below instead
# JARVIS_DICTATE_KEY=<ctrl>+<alt>+d
# JARVIS_ASK_KEY=<ctrl>+<alt>+a
# JARVIS_COMMAND_KEY=<ctrl>+<alt>+j
